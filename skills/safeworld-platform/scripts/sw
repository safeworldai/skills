#!/usr/bin/env python3
"""``sw``: the ``safeworld`` CLI with a ledger. Every call, its exit code and its JSON output land
in ``.safeworld/ledger.jsonl`` under the current directory, so the agent's platform trajectory is
recorded next to the project it tests.

Usage: ``sw <any safeworld arguments>``. Set ``SAFEWORLD_LEDGER`` to move the file.
The API key never reaches the ledger: ``auth login --api-key-stdin`` reads it from stdin, which
this wrapper passes through untouched and never records. Robot keys, passwords, signed URLs and
the Zenoh config are redacted from the recorded result.
"""

from __future__ import annotations

import json
import os
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

LEDGER = Path(
    os.environ.get("SAFEWORLD_LEDGER")
    or Path.cwd() / ".safeworld" / "ledger.jsonl"
)
# Bearer values (robot keys, brain passwords, signed URLs, Zenoh config) never reach the ledger.
SECRET_FIELDS = {"key", "password", "signed_url", "ZENOH_CONFIG_OVERRIDE"}
REDACTED = "<redacted>"


def redact(value: object) -> object:
    if isinstance(value, dict):
        return {k: REDACTED if k in SECRET_FIELDS else redact(v) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v) for v in value]
    if isinstance(value, str) and value.startswith("rk_"):
        return REDACTED
    return value


def main(argv: list[str]) -> int:
    binary = shutil.which("safeworld")
    if binary is None:
        print(
            "sw: the safeworld CLI is not on PATH; a person installs it with install.sh from "
            "https://github.com/safeworldai/skills",
            file=sys.stderr,
        )
        return 2
    started = time.monotonic()
    child = subprocess.Popen(
        [binary, *argv], stdin=sys.stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    )
    # Set after the spawn, so the CLI keeps its own SIGINT handling: a Ctrl-C reaches it, it
    # cancels its run and exits with its own code, and this wrapper still writes the ledger line.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    out, err = child.communicate()
    sys.stdout.write(out)
    sys.stderr.write(err)
    output: object = None
    if "--output-json" in argv:
        try:
            output = redact(json.loads(out))
        except ValueError:
            output = None  # never the raw stdout: it can hold a secret the redaction cannot see
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a") as handle:
        handle.write(
            json.dumps(
                {
                    "at": datetime.now(timezone.utc).isoformat(),
                    "tool": "safeworld",
                    "args": argv,
                    "ok": child.returncode == 0,
                    "exit_code": child.returncode,
                    "wall_s": round(time.monotonic() - started, 3),
                    "result": output,
                    "stderr_tail": err[-800:],
                }
            )
            + "\n"
        )
    return child.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
